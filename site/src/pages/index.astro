---
import Base from '../layouts/Base.astro'
import PaletteMockup from '../components/PaletteMockup.astro'
import Shortcut from '../components/Shortcut'
import StoreButtons from '../components/StoreButtons.astro'

const base = import.meta.env.BASE_URL

const features = [
  {
    emoji: '🔎',
    title: 'Fuzzy search',
    body: 'Search all your bookmarks and commands with a shortcut. Open in the current tab, a new tab, or a new window.',
    href: '/search/',
  },
  {
    emoji: '🔖',
    title: 'Bookmarklet runner',
    body: 'Search and run your javascript: bookmarklets on any page, no console required.',
    href: '/bookmarklets/',
  },
  {
    emoji: '⚡',
    title: 'Built-in commands',
    body: 'Zoom, close and duplicate tabs, open incognito, share a page as markdown, and more.',
    href: '/command-reference/',
  },
  {
    emoji: '📂',
    title: 'User Scripts',
    body: 'Point Hacklets at a local folder of scripts and run them from the palette on demand.',
    href: '/scripts/',
  },
  {
    emoji: '🔁',
    title: 'Repeat last command',
    body: 'Press Cmd+. to re-run whatever you just did. No need to find it again.',
    href: '/shortcuts/',
  },
  {
    emoji: '🧠',
    title: 'Smart ranking',
    body: 'Items you use often float to the top with a recency + frequency scoring model.',
    href: '/search/',
  },
  {
    emoji: '⌨️',
    title: 'Custom shortcuts',
    body: 'Bind any palette item to your own keyboard shortcut and keep your hands on the keys.',
    href: '/shortcuts/',
  },
  {
    emoji: '✏️',
    title: 'Built-in script editor',
    body: 'Create and edit scripts and bookmarklets with a real editor, saved locally.',
    href: '/script-editor/',
  },
]

const shortcuts = [
  { keys: 'Cmd+P', label: 'Bookmarks palette' },
  { keys: 'Cmd+Shift+P', label: 'Commands palette' },
  { keys: 'Cmd+.', label: 'Repeat last command' },
]
---

<Base
  title="Hacklets — Command Palette for Your Browser"
  description="Search bookmarks, run commands, and execute scripts with a VS Code-style command palette in your browser."
>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[500px] rounded-full bg-accent/10 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-5 pt-8 pb-1 text-center">
      <h1 class="mx-auto max-w-3xl text-4xl sm:text-6xl font-bold tracking-tight leading-tight">
        A command palette for
        <span class="text-accent">your browser</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-muted">
        Search bookmarks, run commands, and execute scripts with a Spotlight / VSCode-style palette.
        Press a shortcut and never touch the mouse again.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={base + 'getting-started/'} class="btn-primary">
          Install Hacklets
        </a>
        <a href={base + 'features/'} class="btn-ghost">
          Explore features
        </a>
      </div>

      <div class="mt-5">
        <StoreButtons />
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm font-mono text-muted">
        {shortcuts.map((s) => (
          <span class="inline-flex items-center gap-2 rounded-lg border border-border bg-panel px-3 py-1.5">
            <Shortcut combo={s.keys} />
            {s.label}
          </span>
        ))}
      </div>

      <div class="mt-12">
        <PaletteMockup />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden rounded-2xl border border-border bg-border">
      {features.map((f) => (
        <a href={base.replace(/\/$/, '') + f.href} class="group bg-bg p-6 hover:bg-panel transition-colors">
          <div class="mb-3 text-2xl">{f.emoji}</div>
          <h3 class="font-semibold text-ink group-hover:text-accent transition-colors mb-1.5">
            {f.title}
          </h3>
          <p class="text-sm text-muted leading-relaxed">{f.body}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="rounded-2xl border border-border bg-panel p-8 sm:p-12 flex flex-col md:flex-row items-start md:items-center gap-8">
      <div class="flex-1">
        <h2 class="text-2xl font-bold tracking-tight mb-2">Everything stays on your device</h2>
        <p class="text-muted leading-relaxed">
          Hacklets reads bookmarks and runs scripts locally. No accounts, no
          sync, no data collection — nothing leaves your browser.
        </p>
      </div>
      <div class="shrink-0">
        <a href={base + 'privacy/'} class="btn-ghost">Read the privacy policy</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 text-center">
    <h2 class="text-3xl font-bold tracking-tight mb-3">Ready to ditch the mouse?</h2>
    <p class="text-muted mb-8">Install from source, run your first command in under a minute.</p>
    <a href={base + 'getting-started/'} class="btn-primary text-lg">
      Get started
    </a>
  </section>
</Base>
