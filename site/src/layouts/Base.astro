---
import Analytics from '../components/Analytics.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  ogImage?: string
}

const { title, description, ogImage } = Astro.props
const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={base + 'favicon.png'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hacklets" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.origin + '/hacklets' + Astro.url.pathname} />
    <meta property="og:image" content={base + (ogImage ?? 'hacklets-opengraph-tile.png')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={base + 'sitemap-index.xml'} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Analytics />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
