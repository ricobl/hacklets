---
const base = import.meta.env.BASE_URL
const links = [
  { href: '/features/', label: 'Features' },
  { href: '/search/', label: 'Search' },
  { href: '/scripts/', label: 'Scripts' },
  { href: '/bookmarklets/', label: 'Bookmarklets' },
  { href: '/shortcuts/', label: 'Shortcuts' },
  { href: '/faq/', label: 'FAQ' },
]
---

<header class="border-b border-border bg-bg/80 backdrop-blur sticky top-0 z-40">
  <nav class="mx-auto max-w-6xl px-5 h-14 flex items-center justify-between gap-6">
    <a href={base} class="flex items-center gap-2.5 shrink-0">
      <img src={base + 'favicon.png'} alt="" class="w-6 h-6 rounded" />
      <span class="font-semibold tracking-tight">Hacklets</span>
    </a>
    <div class="hidden md:flex items-center gap-5">
      {links.map((l) => (
        <a href={base.replace(/\/$/, '') + l.href} class="nav-link">{l.label}</a>
      ))}
    </div>
    <a
      href={base + 'getting-started/'}
      class="hidden sm:inline-flex rounded-md bg-accent text-bg font-semibold text-sm px-3 py-1.5 hover:brightness-110 transition-all"
      >Get Started</a
    >
  </nav>
</header>
