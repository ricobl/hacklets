---
const base = import.meta.env.BASE_URL
const groups = [
  {
    heading: 'Product',
    links: [
      { href: '/features/', label: 'Features' },
      { href: '/getting-started/', label: 'Getting Started' },
      { href: '/browser-support/', label: 'Browser Support' },
    ],
  },
  {
    heading: 'Documentation',
    links: [
      { href: '/search/', label: 'Making the Most of Search' },
      { href: '/scripts/', label: 'Scripts' },
      { href: '/bookmarklets/', label: 'Bookmarklets' },
      { href: '/script-editor/', label: 'Script Editor' },
      { href: '/command-reference/', label: 'Command Reference' },
      { href: '/shortcuts/', label: 'Keyboard Shortcuts' },
    ],
  },
  {
    heading: 'Trust',
    links: [
      { href: '/privacy/', label: 'Privacy' },
      { href: '/faq/', label: 'FAQ' },
    ],
  },
]
---

<footer class="border-t border-border bg-panel/40 mt-16">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <img src={base + 'favicon.png'} alt="" class="w-5 h-5 rounded" />
          <span class="font-semibold">Hacklets</span>
        </div>
        <p class="text-sm text-muted">
          Command palette for your browser. Search bookmarks, run commands, and
          execute scripts.
        </p>
      </div>
      {groups.map((g) => (
        <div>
          <h3 class="text-sm font-semibold text-ink mb-3">{g.heading}</h3>
          <ul class="space-y-2">
            {g.links.map((l) => (
              <li>
                <a href={base.replace(/\/$/, '') + l.href} class="text-sm text-muted hover:text-accent transition-colors">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-10 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-2 text-sm text-muted">
      <span>Runs entirely locally. No data leaves your browser.</span>
    </div>
  </div>
</footer>
